<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SolaPraise</string>
	<key>CFBundleDisplayName</key>
	<string>SolaPraise</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ESVAPIKey</key>
	<string>$(ESV_API_KEY)</string>
	<key>ChurchSheetId</key>
	<string>$(CHURCH_SHEET_ID)</string>
	<key>TeamSheetId</key>
	<string>$(TEAM_SHEET_ID)</string>
	<key>YouTubeAPIKey</key>
	<string>$(YOUTUBE_API_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ==== Google Sign-In ====================================== -->
	<!-- iOS OAuth client id. Public by design — native apps are "public
	     clients" with no client secret, so this is safe to commit. -->
	<key>GIDClientID</key>
	<string>329323117480-ghhbbnhuo5bp11cgud0q2sbt98fnpmg3.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Reversed client id, e.g. com.googleusercontent.apps.1234-abcd -->
				<string>com.googleusercontent.apps.329323117480-ghhbbnhuo5bp11cgud0q2sbt98fnpmg3</string>
			</array>
		</dict>
	</array>

	<!-- The player page is served over loopback HTTP by LocalPlayerServer,
	     because YouTube's embed needs a real origin and Referer. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- ==== Background refresh ================================== -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.juyoungkim.solapraise.refresh</string>
	</array>

	<!-- Phase 6: key detection listens through the mic while the song plays. -->
		<key>UIDesignRequiresCompatibility</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>SolaPraise listens to the song playing to detect its musical key and chords.</string>
</dict>
</plist>
