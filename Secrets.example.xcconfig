// Copy to Secrets.xcconfig (gitignored) and fill in.
//
// YOUTUBE_API_KEY lets teammates use the app without signing in: feeds,
// search, playback and the readers all work from public data. Restrict the
// key to this bundle id in the Cloud Console — a key shipped in a binary can
// be extracted, and the bundle restriction is what makes a lifted one
// useless. Leave it blank and the app requires sign-in, as before.
//
// Note the escape: // inside a value starts a comment in xcconfig, so an
// https:// anywhere here needs $()/ tricks. Plain keys are unaffected.
YOUTUBE_API_KEY =

// The team's planning sheet, so nobody has to paste the same URL on their
// own device. Not a secret — Google's sharing decides who can read it — but
// it is the team's document, so it stays out of the repository.
TEAM_SHEET_ID =

// Crossway's ESV key, so every teammate does not have to register one.
// Non-commercial use only: no charging, no advertising.
ESV_API_KEY =

// The church's own information sheet, read for 헌신찬양 and 설교제목 only.
// A different document from the team's planner, owned by the office, and
// never written to. Optional — leave it blank and those two lines simply do
// not appear.
CHURCH_SHEET_ID =
